@comment{
  Working papers for the research page. Use @unpublished (or @misc for SSRN/arXiv) entries, for example:

  unpublished{pain_wp1,
    title    = {Paper Title},
    author   = {Pain, Krishnendu and Coauthor, A.},
    note     = {Working paper},
    year     = {2026},
    pdf      = {pain_wp1.pdf},
    html     = {https://papers.ssrn.com/...},
    abstract = {...}
  }
  (put an "at" sign before "unpublished" when you copy it)
}
